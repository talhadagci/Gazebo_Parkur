<?xml version="1.0" ?>
<robot name="rover">

  <!-- ============ GÖVDE (tekersiz) ============ -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="4.238" ixy="0.0" ixz="0.0" iyy="12.844" iyz="0.0" izz="14.914"/>
    </inertial>
    <visual>
      <!-- Merkez kaymasi = sasi Y merkezi 0.564'tu, bunu 0'a cektik, ty=-0.283 -->
      <origin xyz="0.061 -0.283 0.037" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/tekersizmontaj.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <!-- Simetrik collision = arac Y=0 etrafinda dengeli -->
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="1.68 0.865 0.46"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ============ ZED2i STEREO KAMERA ============ -->
  <link name="zed_camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.166"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Mesh uzun ekseni kendi X'inde, Rz(90) ile rover Y'sine cevrildi;
           xyz degerleri mesh'in kayik merkezini link orijinine tasiyor -->
      <origin xyz="-0.018 0.037 -0.006" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/ZED2i.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
  </link>

  <joint name="zed_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_camera_link"/>
    <!-- Govde on kenari x=0.84, ustu z=0.42; kamera on-uste montajli -->
    <origin xyz="0.30 0 0.475" rpy="0 0 0"/>
  </joint>

  <!-- ZED2i stereo sensor - sol/sag goz ayni anda render edilir, baseline 12 cm -->
  <gazebo reference="zed_camera_link">
    <sensor type="multicamera" name="zed_stereo_camera">
      <update_rate>30.0</update_rate>
      <camera name="left">
        <pose>0 0.06 0 0 0 0</pose>
        <horizontal_fov>1.919</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>40.0</far>
        </clip>
      </camera>
      <camera name="right">
        <pose>0 -0.06 0 0 0 0</pose>
        <horizontal_fov>1.919</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>40.0</far>
        </clip>
      </camera>
      <plugin name="zed_stereo_controller" filename="libgazebo_ros_camera.so">
        <camera_name>zed</camera_name>
        <frame_name>zed_camera_link</frame_name>
        <hack_baseline>0.12</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============ ÖN SOL TEKERLEK ============ -->
  <link name="front_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <!-- teker.dae merkezi (0.5074, 0.22, 0) noktasında, ekseni X yönünde;
           Rz(90) ile eksen Y'ye çevrilip merkez orijine taşınıyor -->
      <origin xyz="0.22 -0.5074 0" rpy="0 0 1.57079632679"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/teker.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.19" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <!-- Hub merkezi = Y 0.379 (wheel height z 0.019) -->
    <origin xyz="0.62 0.379 0.029" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="200" velocity="30"/>
  </joint>

  <gazebo reference="front_left_wheel">
    <mu1>1.2</mu1>
    <mu2>0.6</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.003</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ============ ÖN SAĞ TEKERLEK ============ -->
  <link name="front_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="-0.22 0.5074 0" rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/teker.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.19" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <!-- Hub merkezi = Y -0.380 (wheel height z 0.020) -->
    <origin xyz="0.63 -0.380 0.029" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="200" velocity="30"/>
  </joint>

  <gazebo reference="front_right_wheel">
    <mu1>1.2</mu1>
    <mu2>0.6</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.003</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ============ ARKA SOL TEKERLEK ============ -->
  <link name="rear_left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="0.22 -0.5074 0" rpy="0 0 1.57079632679"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/teker.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.19" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <!-- Hub merkezi = Y 0.379 (wheel height z 0.019) -->
    <origin xyz="-0.52 0.379 0.029" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="200" velocity="30"/>
  </joint>

  <gazebo reference="rear_left_wheel">
    <mu1>1.2</mu1>
    <mu2>0.6</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.003</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ============ ARKA SAĞ TEKERLEK ============ -->
  <link name="rear_right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="-0.22 0.5074 0" rpy="0 0 -1.57079632679"/>
      <geometry>
        <mesh filename="package://rover_parkur/meshes/teker.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.19" length="0.14"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <!-- Hub merkezi = Y -0.380 (wheel height z 0.019) -->
    <origin xyz="-0.51 -0.380 0.029" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.05"/>
    <limit effort="200" velocity="30"/>
  </joint>

  <gazebo reference="rear_right_wheel">
    <mu1>1.2</mu1>
    <mu2>0.6</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.003</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ============ ROS2_CONTROL - 4 BAĞIMSIZ MOTOR ============ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher_rover</robot_param_node>
      <parameters>${CONTROLLERS_CONFIG}</parameters>
    </plugin>
  </gazebo>

</robot>
